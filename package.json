{
  "name": "social-media-2010",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "npm run build",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:staging:dry-run": "npm run build:staging && wrangler deploy --dry-run",
    "preview": "vite preview",
    "test:seed": "node scripts/validate-seed-content.mjs",
    "test:public-twitter": "node scripts/validate-public-twitter.mjs",
    "mail:serve": "node server/flickrMailServer.mjs",
    "test:flickr-mail": "node src/mail/flickrMailController.test.mjs && node server/flickrMail.test.mjs && node worker/flickrMailWorker.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.185.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.4",
    "wrangler": "^4.139.0"
  }
}
